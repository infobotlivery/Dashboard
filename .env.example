# Base de datos SQLite
# Para Docker/Dokploy usar: file:/app/data/metrics.db
DATABASE_URL="file:/app/data/metrics.db"

# API Key para N8N (CAMBIA ESTO)
API_SECRET_KEY="genera-una-clave-aleatoria-larga"

# URL base de la aplicación
NEXT_PUBLIC_APP_URL="https://tu-dominio.com"

# Calendly: token personal (Calendly > Integraciones > API y webhooks > Personal access tokens)
# Con él el dashboard sincroniza las llamadas agendadas automáticamente.
CALENDLY_API_TOKEN=""
# Opcional: solo contar eventos cuyo nombre contenga este texto (ej. "IA AUDIT")
CALENDLY_EVENT_NAME_FILTER=""
